# Build output.
/target

# The NDK's C++ runtime, copied in per ABI so `cargo apk` can package it --
# see docs/BUILDING.md. It belongs to whichever NDK built the library, so it
# is reproduced at build time rather than committed.
/crates/tgpulse/arm64-v8a
/crates/tgpulse/armeabi-v7a

# Romsets, and the battery-backed RAM and save states written beside them.
/roms
/states
*.nv.sav
